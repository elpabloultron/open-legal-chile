# Artefactos de medios generados (promo/demo), no parte del paquete
brag-output/

# SQLite en modo WAL (los deja abiertos la base de doctrina)
*.db-shm
*.db-wal
*.db-journal

# Datos derivados y regenerables (los publica Hugging Face, no el repo)
data/*.jsonl

# Derivados pesados: se regeneran con scripts/optimizar_catalogo_hf.py y
# scripts/cosechar_jurisprudencia_2anios.py, y quedan publicados en Hugging Face.
data/jurisprudencia/cs_sentencias_2anios.jsonl
data/catalogo/instituciones_lite.jsonl

# Textos íntegros nuevos (sentencias del TC y publicaciones ambientales):
# se publican en Hugging Face y se regeneran con scripts/tc_pdfs_a_md.py y
# scripts/publicaciones_a_md.py. Solo se versionan los README de cada carpeta.
jurisprudencia_tc/*.md
!jurisprudencia_tc/README.md
jurisprudencia_tc/pdf/
publicaciones_ambientales/*.md
!publicaciones_ambientales/README.md
publicaciones_ambientales/pdf/

# Biblioteca ambiental (libros del concurso, informes en derecho, foros, manuales y material
# docente): se convierte con scripts/biblioteca_ambiental_a_md.py y se publica en Hugging Face.
# Solo se versiona el README; el material fuente del usuario queda fuera del repositorio.
biblioteca_ambiental/*.md
!biblioteca_ambiental/README.md
biblioteca_ambiental/pdf/
ambiental/

# Fichas de la Corte Suprema y sentencias ambientales: se regeneran con
# scripts/cs_a_markdown.py y scripts/ambientales_a_md.py, y se publican en Hugging Face.
# Solo se versiona el README de cada colección.
jurisprudencia_cs/*/
jurisprudencia_cs/*.md
!jurisprudencia_cs/README.md
jurisprudencia_ambiental/*/
jurisprudencia_ambiental/*.md
!jurisprudencia_ambiental/README.md

# Revistas de derecho (RDPUCV y periódicos jurídicos): se publican en Hugging Face
doctrina/revistas/**/*.md
!doctrina/revistas/README.md

# Al recuperar el repositorio se aparta el .git dañado: nunca dentro del árbol
.git_dañado_*/
.git_dañado_*

# material de la charla y presentaciones: local, no se publica en el repositorio
docs/charla/
charla/
*presentacion*
scripts/build_presentacion*
*.pptx
*.key

# Herramientas de auditoría externas auxiliares
.agents/skills/security-audit/

# Planes de trabajo por workspace (viven con el repo, no se versionan)
.hermes/
