# ==============================================================================
# OPEN LEGAL CHILE — CONFIGURACIÓN DE VARIABLES DE ENTORNO Y LLAVES DE API
# ==============================================================================
# Copia este archivo como '.env' y completa con tus credenciales personales:
#   cp .env.example .env
#
# NOTA IMPORTANTE:
# El archivo '.env' contiene llaves privadas y está protegido en '.gitignore'.
# Cada usuario del proyecto debe generar sus propias credenciales en los portales
# oficiales del Estado de Chile o en su proveedor de IA preferido.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FUENTES DE DATOS DEL ESTADO DE CHILE (Oficiales)
# ------------------------------------------------------------------------------
# BCN LEY CHILE: (OPCIONAL — NO REQUERIDA)
# Open Legal Chile consulta directamente los repositorios XML públicos de la BCN sin clave.
# Solo configúrala si posees una llave histórica del Web Service v1.
# BCN_API_KEY=tu_api_key_opcional_aqui

# CNE ENERGÍA ABIERTA: Regístrate gratuitamente en: https://api.cne.cl/
CNE_EMAIL=tu_correo@ejemplo.cl
CNE_PASSWORD=tu_contraseña_cne_aqui

# ------------------------------------------------------------------------------
# 2. PROVEEDORES DE INTELIGENCIA ARTIFICIAL (BYOK - Usa tu modelo preferido)
# ------------------------------------------------------------------------------
# Anthropic Claude (Recomendado para redacción jurídica compleja y forense)
ANTHROPIC_API_KEY=tu_anthropic_api_key_aqui

# Google Gemini (Ultrarrápido y potente en análisis de documentos)
GEMINI_API_KEY=tu_gemini_api_key_aqui

# DeepSeek (Excelente en razonamiento lógico-jurídico y bajo costo)
DEEPSEEK_API_KEY=tu_deepseek_api_key_aqui

# OpenAI (GPT-4o / o3-mini)
OPENAI_API_KEY=tu_openai_api_key_aqui

# Ollama / Modelos Locales (Opcional, por defecto http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# ------------------------------------------------------------------------------
# 3. PUERTO DEL SERVIDOR WEB LOCAL (Opcional, por defecto 8000)
# ------------------------------------------------------------------------------
PORT=8000
